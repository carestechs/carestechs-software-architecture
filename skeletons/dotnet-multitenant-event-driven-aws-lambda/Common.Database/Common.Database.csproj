<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="dbup-postgresql" Version="5.*" />
    <!-- dbup-postgresql transitively pins Npgsql 3.2.7 (GHSA-x9vc-6hfv-hg8c);
         direct reference wins and lifts it to the patched line -->
    <PackageReference Include="Npgsql" Version="10.0.*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Scripts/*.sql" />
  </ItemGroup>
</Project>
