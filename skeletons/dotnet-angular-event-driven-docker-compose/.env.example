# Local development (adrs/deployment/env-connection-urls.md).
# The laptop runs the production engines — same PostgreSQL, same RabbitMQ
# (docker-compose.yml); there is nothing to emulate.
DATABASE_URL=Host=localhost;Port=5432;Database=app;Username=postgres;Password=postgres
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Optional tuning (defaults shown; retry policy is broker topology — adrs/deployment/rabbitmq-broker.md)
#RABBITMQ_RETRY_TTL_MS=5000
#RABBITMQ_MAX_ATTEMPTS=3
#OUTBOX_POLL_MS=2000
