# Copy to .env for local development (adrs/deployment/env-connection-urls.md)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
DEBUG=true
# HS256 signing secret, minimum 32 bytes (adrs/api/jwt-bearer-auth.md)
JWT_SECRET=change-me-to-a-random-32-byte-minimum-secret
# Celery broker + result backend (adrs/python/celery-background-jobs.md)
REDIS_URL=redis://localhost:6379/0
